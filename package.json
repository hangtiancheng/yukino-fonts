{
  "name": "@yukino.js/fonts",
  "version": "0.0.1",
  "description": "@yukino.js/fonts",
  "type": "module",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./extended": {
      "types": "./build/extended.d.ts",
      "default": "./build/extended.js"
    },
    "./rico": {
      "types": "./build/rico.d.ts",
      "default": "./build/rico.js"
    },
    "./Yukino/*": "./build/Yukino/*",
    "./Rico/*": "./build/Rico/*"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --mode lib && tsc -p tsconfig.build.json",
    "format": "prettier -w ./ --experimental-cli",
    "dev": "vite",
    "lint": "eslint --fix ./",
    "build:fe": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build",
    "git:config": "git config user.name hangtiancheng && git config user.email '161043261@qq.com'",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:push": "pnpm git:commit && git push origin main"
  },
  "bugs": {
    "url": "https://github.com/hangtiancheng/yukino-fonts/issues"
  },
  "homepage": "https://github.com/hangtiancheng/yukino-fonts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hangtiancheng/yukino-fonts"
  },
  "keywords": [
    "fonts",
    "yukino",
    "monospace",
    "next-font"
  ],
  "author": "https://github.com/hangtiancheng",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "peerDependencies": {
    "next": ">=13"
  },
  "dependencies": {
    "jotai": "^2.20.3",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@yukino.js/lit-jsx": "latest",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "next": "^16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
